frontend,src/tagcast/static/lookup.js,175,"Metadata editor helpers: credits, genres, online lookup, artwork",ui,html-text,ui-prop,innerHTML,24,0,0,"Choose sources for metadata, image suggestions and lyrics. All are selected by default. Unchecking a source keeps its saved key. Changes apply after Save."
frontend,src/tagcast/static/lookup.js,175,"Metadata editor helpers: credits, genres, online lookup, artwork",ui,html-text,ui-prop,innerHTML,56,0,0,"TheAudioDB artist biographies and album information use their separate switches under Discovery. Find lyrics sends track title, artist, album and known duration to LRCLIB and caches text on this computer. The optional online Now playing mode also uses LRCLIB after a missing Unison result, with album name when available; those display results stay only in memory."
frontend,src/tagcast/static/lookup.js,175,"Metadata editor helpers: credits, genres, online lookup, artwork",ui,html-text,ui-prop,innerHTML,25,1,0,"These sources work without a key: {}. Add a key to use the others. Keys are stored on this computer only, in the Tagcast settings folder."
