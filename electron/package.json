{
  "name": "tagcast-desktop",
  "productName": "Tagcast Gapless Test",
  "version": "0.80.0",
  "description": "Local experimental gapless playback build of Tagcast.",
  "author": "Cyberdelia",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "nl.cyberdelia.tagcast.gapless-validation",
    "executableName": "Tagcast",
    "asar": true,
    "directories": {"output": "out"},
    "files": ["*.cjs", "package.json"],
    "extraResources": [
      {"from": "../build/electron/backend/tagcast-server", "to": "backend"},
      {"from": "../build/assets/tagcast-icon.png", "to": "tagcast-icon.png"},
      {"from": "../LICENSE", "to": "LICENSE"}
    ],
    "afterPack": "./harden.cjs",
    "artifactName": "tagcast-desktop-${version}-${os}-${arch}.${ext}",
    "mac": {"target": ["zip"], "icon": "../build/assets/tagcast.icns", "category": "public.app-category.music", "identity": "-"},
    "win": {"target": ["zip"], "icon": "../build/assets/tagcast.ico"},
    "linux": {"target": ["tar.gz"], "icon": "../build/assets/tagcast-icon.png", "category": "Audio"}
  }
}
